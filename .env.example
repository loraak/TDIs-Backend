# =====================================================================
# Variables de entorno para PRODUCCIÓN (SPRING_PROFILES_ACTIVE=prod)
# Copia este archivo como .env (no se sube a git) o captúralas en la
# configuración de tu plataforma (Cloud Run, Railway...).
# En local NO necesitas nada de esto: el perfil dev usa valores por defecto.
# =====================================================================

# NOTA: en Google Cloud no necesitas llenar esto a mano; deploy/02-desplegar.sh
# lo configura todo. Este archivo es la referencia de qué variables existen.

# --- Todos los servicios ---
SPRING_PROFILES_ACTIVE=prod

# URLs de Cloud Run de los demás servicios (sin Eureka en producción).
# Cada servicio usa solo las que necesita.
USUARIOS_URL=https://usuarios-service-PROJECT_NUMBER.us-central1.run.app
CATALOGO_URL=https://catalogo-service-PROJECT_NUMBER.us-central1.run.app
TRAMITES_URL=https://tramites-service-PROJECT_NUMBER.us-central1.run.app
PROGRESO_URL=https://progreso-service-PROJECT_NUMBER.us-central1.run.app
DOCUMENTOS_URL=https://documentos-service-PROJECT_NUMBER.us-central1.run.app

# --- api-gateway y usuarios-service (DEBE ser el mismo valor en ambos) ---
# Genera uno NUEVO (no reutilices el del repo):  openssl rand -base64 48
JWT_SECRET=
# Opcional, en milisegundos (default 24 h)
# JWT_EXPIRATION=86400000

# --- api-gateway ---
# Orígenes del frontend, separados por coma
CORS_ALLOWED_ORIGINS=https://tdis-frontend.vercel.app

# --- usuarios, catalogo, tramites, documentos (cada uno con SU base) ---
# Ej: jdbc:postgresql://HOST:5432/tdis_usuarios
DATABASE_URL=
DB_USERNAME=
DB_PASSWORD=
# Conexiones por servicio (Cloud SQL db-f1-micro aguanta ~25 en total)
# DB_POOL_SIZE=2

# --- usuarios-service: administrador inicial ---
# Solo se usa si no existe ningún administrador. Mínimo 12 caracteres.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- catalogo-service ---
# "always" en el PRIMER despliegue si quieres el catálogo inicial de data.sql
# (solo inserta si la tabla está vacía). Después vuelve a "never" o quítala.
# CATALOGO_CARGA_INICIAL=never

# --- tramites-service ---
# Vacío = sin IA (todo queda en "Requiere revisión" para el admin)
N8N_WEBHOOK_URL=

# --- documentos-service ---
# En Cloud Run el bucket se monta aquí:
UPLOAD_DIR=/mnt/evidencias
